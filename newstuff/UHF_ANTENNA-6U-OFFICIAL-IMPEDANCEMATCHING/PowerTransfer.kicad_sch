	(text "USB-C Power Delivery"
		(exclude_from_sim no)
		(at 151.13 19.558 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "67d345c8-1c3f-4ae4-ab6b-82fe33b530af")
	)
	(text "USB-C POWER DELIVERY CONFIGURATION\nController: CYPD3177-24LQXQ (U11)\nOperating mode: USB-PD sink\n\nVBUS_MIN = VBUS_MAX = VDDD (R72 = 0 ohm)\nRequested voltage = 20 V\n\nISNK_COARSE: R70 = 5.1 kohm, R71 = 2.4 kohm\nISNK_FINE = GND (+0 A)\nRequested current = 2 A\n\nNominal requested power:\nP = V * I = 20 V * 2 A = 40 W\n"
		(exclude_from_sim no)
		(at 258.064 100.076 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a42566f8-e64d-4b3e-b875-0453e792fb03")
	)
	(text "Power flow:\nJ27 (USB-C) -> VBUS -> Q27/Q28 -> VDC_OUT\n-> J2 -> External BMS board\n\nU11 negotiates the requested USB-PD contract using CC1/CC2.\nVBUS_FET_EN controls the external PMOS switches.\nR73 = 49.9 kohm: Gate-to-source pull-up bias.\nR74 = 1 kohm: Series gate-drive resistor.\nVDC_OUT is switched VBUS, NOT a regulated 20 V output.\n\nIf a suitable PD contract is unavailable, the normal\nVBUS_FET_EN path is not enabled. SAFE_PWR_EN is unused."
		(exclude_from_sim no)
		(at 149.352 38.608 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d683a0fe-0667-4161-b259-faa2c41e75a4")
	)
